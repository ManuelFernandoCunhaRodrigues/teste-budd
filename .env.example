# Copy to `.env` and adjust. Only EXPO_PUBLIC_* variables reach the app bundle,
# and everything here ships inside the client — never store secrets in this file.

# Base URL of the Budd API.
#
# Leave this unset while no server exists: the app then reports the critical
# flows (sign-in, checkout, top-up, tickets) as unavailable instead of faking a
# result. Setting it makes the app talk to that host for real.
# EXPO_PUBLIC_API_URL=https://api.budd.app

EXPO_PUBLIC_API_TIMEOUT=15000

# In-memory development backend.
#
# Off by default, and additionally gated behind `__DEV__`, so it can never be
# reached from a production build. Enable it to exercise the real flows without a
# server: it enforces server-side idempotency, keeps a PIX charge `pending` until
# something explicitly settles it, and credits a wallet exactly once.
#
# It never confirms a payment on its own. While it is active, the payment panel
# shows a "[dev] Simular confirmação do PIX" control that stands in for the
# provider webhook.
#
# Seeded credentials: demo@budd.app / budd1234
EXPO_PUBLIC_ENABLE_DEV_BACKEND=false

# Google Maps key for Android, read by `app.config.ts`.
#
# Not an EXPO_PUBLIC_ variable on purpose: it is consumed at config time and
# baked into the native manifest, not read by app code at runtime.
#
# Only Android needs it — the app uses PROVIDER_DEFAULT, which is Apple Maps on
# iOS. Expo Go supplies its own credentials, so a missing key only shows up as a
# blank map in a real build; the build fails loudly instead.
#
# Restrict the key in Google Cloud (package name + SHA-1 + Maps SDK for Android
# only). Being in an env var protects the repo, not the APK.
GOOGLE_MAPS_ANDROID_API_KEY=
