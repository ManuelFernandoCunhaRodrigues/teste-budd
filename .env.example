# Copy to `.env` and adjust. Only EXPO_PUBLIC_* variables reach the app bundle,
# and everything here ships inside the client — never store secrets in this file.
#
# Values below are neutral examples, never real credentials or contacts.

# --- Environment -----------------------------------------------------------

# Target environment: development | staging | production.
#
# Selected explicitly rather than inferred from __DEV__, so a staging build is not
# treated as production. Set per build profile in `eas.json`. When unset, a dev
# bundle is `development` and any other bundle is treated as `production` — the
# strictest option, so an unconfigured release fails loudly.
EXPO_PUBLIC_APP_ENV=development

# --- API -------------------------------------------------------------------

# Base URL of the Budd API. Validated at startup.
#
# There is deliberately NO fallback host. Leaving it unset in development is fine:
# server-dependent flows report themselves unavailable instead of pretending to
# work. In production a missing, http, local or example URL blocks startup.
# EXPO_PUBLIC_API_URL=https://api.example-not-real.test

# Request timeout in milliseconds. Must be a positive number.
EXPO_PUBLIC_API_TIMEOUT=15000

# --- Support ---------------------------------------------------------------

# WhatsApp support number, with or without formatting:
#   +55 (98) 91234-5678   or   5598912345678
#
# Normalised to digits and validated. Known placeholders are rejected — including
# the number that used to be hard-coded in the app. Support is optional: with no
# valid number the menu entry is disabled and shows "Atendimento indisponível",
# rather than opening a chat with whoever owns a made-up number.
EXPO_PUBLIC_WHATSAPP_SUPPORT_NUMBER=

# --- Development backend ---------------------------------------------------

# In-memory development backend.
#
# Off by default, and additionally gated behind `__DEV__`, so it can never be
# reached from a production build. Enabling it in a production build is a blocking
# configuration error.
#
# It never confirms a payment on its own: while active, the payment panel shows a
# "[dev] Simular confirmação do PIX" control standing in for the provider webhook.
#
# Seeded credentials: demo@budd.app / budd1234
EXPO_PUBLIC_ENABLE_DEV_BACKEND=false

# --- Native build (not EXPO_PUBLIC_) ---------------------------------------

# Google Maps key for Android, consumed by `app.config.ts` at config time and
# baked into the native manifest — not read by app code at runtime.
#
# Only Android needs it: the app uses PROVIDER_DEFAULT, which is Apple Maps on
# iOS. Expo Go supplies its own credentials, so a missing key only shows up as a
# blank map in a real build; the build fails loudly instead.
#
# Restrict the key in Google Cloud (package name + SHA-1 + Maps SDK for Android
# only). Being in an env var protects the repo, not the APK. For EAS builds use
# `eas secret:create` rather than committing a `.env`.
GOOGLE_MAPS_ANDROID_API_KEY=
